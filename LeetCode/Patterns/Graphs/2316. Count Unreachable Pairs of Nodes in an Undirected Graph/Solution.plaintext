                q.push(i);
                visited[i]=true;
                while(!q.empty()){
                    int node=q.front();
                    q.pop();
                    v++;
                    for(auto nei:adj[node]){
                        if(!visited[nei]){
                            visited[nei]=true;
                            q.push(nei);
                        }
                    }
                }
                pairs+=(n-v)*v;
            }
        }
        return pairs/2;
                int v=0;
    }
};
